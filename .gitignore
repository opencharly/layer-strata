.build/
*.log
__pycache__/
*.pyc

# Generated context-ignore files (podman reads .containerignore, docker .dockerignore).
# The org-wide convention is to ignore them, not commit them: layer-openclaw and
# distro-fedora carry the identical three lines.
.containerignore
.dockerignore

# `charly check run` writes each bed's evidence here (summary.yml, per-step logs, recordings).
# The org convention is to ignore the tree, not to commit it — distro-cachyos carries the same line.
.check/
